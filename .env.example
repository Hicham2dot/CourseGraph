# Copier en .env et adapter les valeurs

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=coursegraph

# Ollama / LLM
OLLAMA_URL=http://localhost:11434
LLM_MODEL=mistral:7b-instruct
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# NLI (hallucination checker)
NLI_MODEL=cross-encoder/nli-deberta-v3-base
NLI_THRESHOLD=0.5

# RAG
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
ABSTENTION_THRESHOLD=0.3

# SQLite
DATABASE_URL=sqlite:///./coursegraph.db

# Logging
LOG_LEVEL=INFO
